# Copy this file to .env and fill in the key if you want language-model designs.
# .env is gitignored. Real environment variables take precedence over it.

DEEPSEEK_API_KEY=

# DeepSeek model id. Use deepseek-chat if your account does not expose deepseek-flash.
FORGE_LLM_MODEL=deepseek-flash

# Optional: point at any OpenAI-compatible endpoint.
FORGE_LLM_BASE_URL=https://api.deepseek.com

# Reasoning models need room before emitting the final JSON.
FORGE_LLM_MAX_TOKENS=8192
FORGE_LLM_TIMEOUT=120

# none = fast. low/medium/high = slower, deeper reasoning.
FORGE_LLM_REASONING=none

# Optional server bind.
# FORGE_HOST=127.0.0.1
# FORGE_PORT=7860
